rules_version = '2';

// ============================================================================
// TeachTool — Firestore Security Rules  (v3 — 2026-11-01)
// ----------------------------------------------------------------------------
// Nguyên tắc:
//   1. Mỗi giáo viên CHỈ đọc/ghi được dữ liệu của chính mình
//      (request.auth.uid == uid trên toàn bộ đường dẫn).
//   2. Mọi thứ khác bị TỪ CHỐI. Không có "allow read, write: if true".
//   3. Validate kiểu + giới hạn độ dài để chặn document phình to / dữ liệu rác.
//   4. Hạn ngạch (quota) không bảo vệ được bằng rules — xem docs/firestore-schema.md
//      để biết cách tối ưu reads/writes.
//
// THAY ĐỔI v3 — sửa 2 điều kiện CHẶN NHẦM chức năng (đã kiểm chứng emulator):
//   [1] groups.update: BỎ ràng buộc "total chỉ được chênh ±1000 mỗi write".
//       Ràng buộc cũ chặn nhầm nút "Đặt lại điểm": một nhóm đã tích 2500 sao
//       không thể đưa về 0 trong một write (Firestore trả 403 kèm
//       "evaluation error", không phải PERMISSION_DENIED rõ nghĩa).
//       Giới hạn thật của một :commit là 500 thao tác, và `total` đã có trần
//       maxStars() nên không cần chặn biên độ nữa.
//   [2] meta/hierarchy: BỎ `schools.size() >= 1`.
//       normalizeHierarchy() luôn tự thêm trường mặc định nên danh mục không
//       rỗng trong thực tế; điều kiện cũ chỉ có tác dụng chặn nhầm thao tác
//       dọn/xoá danh mục. Vẫn giữ has('schools') + trần maxSchools().
//
// Lưu ý về uid: index.html đăng nhập qua Firebase Auth REST và lưu idToken;
// Firestore REST gửi kèm token đó nên request.auth.uid = uid thật của Firebase
// Authentication. Không có đường tắt nào bỏ qua được các rule dưới đây.
//
// CÁCH DÁN AN TOÀN (tránh lỗi copy từ trang GitHub):
//   Dùng link RAW, không dùng trang /blob/:
//   https://raw.githubusercontent.com/hkeyd-124/teachtool/main/firestore.rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Hàm dùng chung
    // ------------------------------------------------------------------

    // Đã đăng nhập chưa
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Chỉ chủ sở hữu: uid trên đường dẫn phải trùng uid trong token
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Chuỗi hợp lệ: đúng kiểu string, độ dài trong [min, max]
    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Số nguyên không âm, có trần
    function isCount(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    // Field có tồn tại trong dữ liệu gửi lên không
    function has(field) {
      return field in request.resource.data;
    }

    // Giới hạn kích thước (chống document phình to)
    function maxStudents() { return 200; }
    function maxStars()    { return 100000; }
    function maxGroups()   { return 50; }
    function maxSchools()  { return 20; }   // một giáo viên hiếm khi dạy > 20 trường
    function maxClasses()  { return 30; }   // mỗi trường tối đa 30 lớp

    // ID chỉ gồm chữ thường, số, gạch dưới.
    // QUAN TRỌNG: id học sinh được dùng làm khoá trong map `stars`, rồi trở thành
    // một phần của field path khi gọi `increment`. Nếu id chứa dấu "." hoặc các
    // ký tự đặc biệt thì field path sẽ bị hiểu sai. Rule này chặn điều đó.
    // Áp dụng cho cả groupId, schoolId, classId (đều là khoá an toàn).
    function isSafeId(v) {
      return v is string
             && v.size() >= 3
             && v.size() <= 40
             && v.matches('^[a-z0-9_]+$');
    }

    // ------------------------------------------------------------------
    // /users/{uid}  — hồ sơ giáo viên
    // ------------------------------------------------------------------
    match /users/{uid} {

      allow read: if isOwner(uid);

      // Tạo hồ sơ: phải có username, plan mặc định "free"
      allow create: if isOwner(uid)
                    && has('username')
                    && isStr(request.resource.data.username, 3, 32)
                    && (!has('plan') || request.resource.data.plan == 'free')
                    && (!has('createdAt') || request.resource.data.createdAt is timestamp);

      // Cập nhật: username / createdAt / plan KHÔNG được đổi.
      // Chỉ được cập nhật các field vận hành (lastSeenAt, ...).
      allow update: if isOwner(uid)
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.plan == resource.data.plan;

      // Không cho xoá hồ sơ từ client (phải làm bằng Admin SDK)
      allow delete: if false;

      // ----------------------------------------------------------------
      // /users/{uid}/features/{featureId}
      // ----------------------------------------------------------------
      match /features/{featureId} {

        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
                      && has('title')
                      && isStr(request.resource.data.title, 1, 60);

        allow update: if isOwner(uid)
                      && resource.data.title == request.resource.data.title;

        // Xoá tính năng: chỉ chủ sở hữu.
        // (Nhóm nên xoá trước — tránh bỏ lại subcollection mồ côi.)
        allow delete: if isOwner(uid);

        // --------------------------------------------------------------
        // /users/{uid}/features/{featureId}/groups/{groupId}
        //   ★ ĐƠN VỊ GHI CHÍNH — xem docs/firestore-schema.md mục 3
        // --------------------------------------------------------------
        match /groups/{groupId} {

          allow read: if isOwner(uid);

          // ---- CREATE ----
          allow create: if isOwner(uid)
                        && isSafeId(groupId)
                        && has('name')
                        && isStr(request.resource.data.name, 1, 60)
                        && (!has('order')     || isCount(request.resource.data.order, maxGroups()))
                        && (!has('students')  || request.resource.data.students.size() <= maxStudents())
                        && (!has('total')     || isCount(request.resource.data.total, maxStars()))
                        // Phân cấp Trường → Lớp (denormalized): id an toàn, tên có trần độ dài
                        && (!has('schoolId')   || isSafeId(request.resource.data.schoolId))
                        && (!has('classId')    || isSafeId(request.resource.data.classId))
                        && (!has('schoolName') || isStr(request.resource.data.schoolName, 1, 60))
                        && (!has('className')  || isStr(request.resource.data.className, 1, 60));

          // ---- UPDATE ----
          // Cho phép:
          //   • tăng/giảm `total` bằng increment
          //   • sửa `name`, `order`
          //   • thêm/xoá học sinh trong `students`
          //   • tăng/giảm một field trong `stars`
          //   • đổi `schoolId/classId` (chuyển nhóm sang lớp khác)
          // KHÔNG cho phép: đổi `createdAt`, phình `students` quá trần,
          //                 star vượt trần.
          // KHÔNG chặn biên độ `total` — xem ghi chú đầu file, sửa lỗi [1].
          allow update: if isOwner(uid)
                        && request.resource.data.name is string
                        && isStr(request.resource.data.name, 1, 60)
                        && request.resource.data.students.size() <= maxStudents()
                        && isCount(request.resource.data.total, maxStars())
                        // Phân cấp Trường → Lớp: nếu có thì phải đúng kiểu/độ dài
                        && (!('schoolId' in request.resource.data)   || isSafeId(request.resource.data.schoolId))
                        && (!('classId' in request.resource.data)    || isSafeId(request.resource.data.classId))
                        && (!('schoolName' in request.resource.data) || isStr(request.resource.data.schoolName, 1, 60))
                        && (!('className' in request.resource.data)  || isStr(request.resource.data.className, 1, 60))
                        // createdAt bất biến (nếu document có field này)
                        && (
                             !('createdAt' in resource.data)
                             || request.resource.data.createdAt == resource.data.createdAt
                           );

          // ---- DELETE ----
          // Chỉ chủ sở hữu. Một write xoá trọn nhóm (vì học sinh nằm trong
          // chính document này — đây là lợi thế của phương án B).
          allow delete: if isOwner(uid);
        }

        // --------------------------------------------------------------
        // /users/{uid}/features/{featureId}/meta/hierarchy
        //   Danh mục Trường → Lớp (1 document duy nhất cho cả tính năng)
        //   { schools:[{id,name,order,classes:[{id,name,order}]}], updatedAt }
        // --------------------------------------------------------------
        match /meta/{metaId} {

          // MỘT document duy nhất, tên cố định "hierarchy" → không cho đẻ thêm doc.
          allow read: if isOwner(uid) && metaId == 'hierarchy';

          // BỎ `schools.size() >= 1` — xem ghi chú đầu file, sửa lỗi [2].
          allow create, update: if isOwner(uid)
                                && metaId == 'hierarchy'
                                && has('schools')
                                && request.resource.data.schools.size() <= maxSchools();

          allow delete: if isOwner(uid) && metaId == 'hierarchy';
        }

        // --------------------------------------------------------------
        // Mọi subcollection khác dưới feature → chặn
        // --------------------------------------------------------------
        match /{rest=**} {
          allow read, write: if false;
        }
      }

      // ------------------------------------------------------------------
      // Mọi subcollection khác dưới user → chặn
      // ------------------------------------------------------------------
      match /{rest=**} {
        allow read, write: if false;
      }
    }

    // --------------------------------------------------------------------
    // MẶC ĐỊNH TỪ CHỐI toàn bộ — bất cứ collection ngoài /users/{uid}
    // --------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

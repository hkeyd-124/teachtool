# ============================================================
# TeachTool — biến môi trường
# Sao chép file này thành .env (local) hoặc nhập vào
# Vercel → Project → Settings → Environment Variables.
# KHÔNG commit file .env thật. KHÔNG đặt giá trị thật vào file này.
# ============================================================

# ---------- Firebase Web SDK (công khai — được trả ra client) ----------
# Lấy tại: Firebase Console → Project settings → General → Your apps → SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ---------- Firebase Admin (BÍ MẬT — chỉ dùng server-side) ----------
# Nội dung JSON của service account, dán thành MỘT dòng.
# Lấy tại: Firebase Console → Project settings → Service accounts → Generate new private key
# TUYỆT ĐỐI không trả biến này ra client, không commit vào git.
FIREBASE_SERVICE_ACCOUNT_JSON=
